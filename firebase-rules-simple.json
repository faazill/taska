{
  "rules": {
    "studentslist": {
      "$studentId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $studentId"
      }
    },
    
    "professionalslist": {
      "$professionalId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $professionalId"
      }
    },
    
    "chats": {
      "$chatId": {
        ".read": "auth != null && $chatId.contains(auth.uid)",
        ".write": "auth != null && $chatId.contains(auth.uid)",
        "messages": {
          "$messageId": {
            ".read": "auth != null && $chatId.contains(auth.uid)",
            ".write": "auth != null && $chatId.contains(auth.uid)"
          }
        }
      }
    },
    
    "tasks": {
      "$taskId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    
    "invites": {
      "$inviteId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    
    "loyalty_students": {
      "$studentId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $studentId"
      }
    },
    
    "loyalty_professional": {
      "$professionalId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $professionalId"
      }
    },
    
    "account_deletions": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    
    "system": {
      ".read": "false",
      ".write": "false"
    },
    
    "analytics": {
      ".read": "false",
      ".write": "false"
    }
  }
}